// ── Funkcja: skanuj poprzednie komentarze i zwróć liczniki ──────────────────
export function countPhraseUsage(
  recentCommentaries: string[],
  currentSetNumber: number
): Record<string, number> {
  const counts: Record<string, number> = {};

  for (const tracked of TRACKED_PHRASES) {
    const key = tracked.phrase;
    counts[key] = 0;
    for (const commentary of recentCommentaries) {
      // Normalizuj: małe litery, usuń polskie znaki
      const normalized = commentary.toLowerCase()
        .replace(/ą/g, 'a').replace(/ę/g, 'e').replace(/ó/g, 'o')
        .replace(/ś/g, 's').replace(/ź/g, 'z').replace(/ż/g, 'z')
        .replace(/ć/g, 'c').replace(/ń/g, 'n').replace(/ł/g, 'l');
      if (normalized.includes(key)) {
        counts[key]++;
      }
    }
  }

  return counts;
}

// ── Funkcja: zbuduj kontekst dla GPT ────────────────────────────────────────
export function buildPhraseWarning(counts: Record<string, number>): string {
  const warnings: string[] = [];

  for (const tracked of TRACKED_PHRASES) {
    const count = counts[tracked.phrase] || 0;
    if (count >= tracked.limit) {
      warnings.push(
        `"${tracked.phrase.replace(/([aeiou])/g, (m, c) => c)}" — już ${count}x w tym secie! ` +
        `Użyj zamiast: ${tracked.alternatives.slice(0, 2).join(' / ')}`
      );
    } else if (count >= tracked.limit - 1 && tracked.limit > 1) {
      warnings.push(
        `"${tracked.phrase}" — już ${count}x (limit: ${tracked.limit}). Rozważ alternatywę.`
      );
    }
  }

  if (warnings.length === 0) return '';

  return `\nFRAZY DO UNIKNIĘCIA W TYM SECIE (już użyte za dużo razy):\n${warnings.map(w => `- ${w}`).join('\n')}\n`;
}
